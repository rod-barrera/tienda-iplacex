# Configuracion de Firebase (Ejercicio 2, punto 3).
#
# Copiar este archivo como .env y reemplazar los valores con los del proyecto
# real. Se obtienen en la consola de Firebase:
#   Configuracion del proyecto > Tus apps > App web > Configuracion del SDK
#
# El archivo .env NO se sube al repositorio (esta en .gitignore).
# En Vite las variables deben empezar con VITE_ para llegar al navegador.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
